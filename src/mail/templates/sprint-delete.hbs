<div
  style='font-family: Arial, sans-serif; max-width:600px; margin:auto; background:#fff; border:1px solid #eee; border-radius:10px; padding:20px;'
>

  <h2 style='color:#d32f2f;'>
    Sprint Deleted
  </h2>

  <p style='color:#555; font-size:14px;'>
    A sprint has been removed from your project.
  </p>

  <div
    style='margin-top:20px; padding:16px; background:#fdecea; border:1px solid #f5c6cb; border-radius:8px;'
  >
    <h3 style='margin:0; color:#cd5555;'>
      {{sprintKey}}
    </h3>

    {{#if projectName}}
      <p style='margin:5px 0; font-size:13px;'>
        Project:
        <strong>{{projectName}}</strong>
      </p>
    {{/if}}
  </div>

  <p style='margin-top:15px; font-size:13px; color:#999;'>
    If this was unexpected, please check with your team.
  </p>

</div>