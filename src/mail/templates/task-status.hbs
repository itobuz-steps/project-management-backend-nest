<div
  style='font-family: Arial, sans-serif; max-width:600px; margin:auto; background:#ffffff; border:1px solid #eee; border-radius:10px; padding:20px;'
>

  <h2 style='color:#0073ff; margin-bottom:10px;'>
    Task Status Updated
  </h2>

  <p style='color:#555; font-size:14px;'>
    The status of the following task has been updated:
  </p>

  <div
    style='margin-top:20px; padding:16px; border-radius:8px; background:#fafafa; border:1px solid #eee;'
  >

    <h3 style='margin:0 0 10px 0; color:#333;'>
      <span style='color:#333; font-weight:600;'>
        {{taskKey}}
      </span>
      —
      {{taskTitle}}
    </h3>

    <div style='display:flex; align-items:center; gap:10px;'>

      <span
        style='
      display:inline-block;
      line-height:1;
      background:#e3f2fd;
      color:#0d47a1;
      padding:10px 12px;
      border-radius:10px;
      font-weight:bold;
      text-decoration: line-through;
    '
      >
        {{oldStatus}}
      </span>

      <span
        style='
    display:inline-flex;
    align-items:center;
    justify-content:center;
    font-size:22px;
    color:#888;
    height:100%;
  '
      >
        ⇨
      </span>

      <span
        style='
      display:inline-block;
      line-height:1;
      background:#e8f5e9;
      color:#1b5e20;
      padding:10px 12px;
      border-radius:10px;
      font-weight:bold;
    '
      >
        {{newStatus}}
      </span>

    </div>
  </div>

  {{#if actorName}}
    <p style='margin-top:15px; font-size:14px; color:#555;'>
      Updated by:
      <strong>{{actorName}}</strong>
    </p>
  {{/if}}

  {{#if projectName}}
    <p style='font-size:16px; color:#000;'>
      Project:
      <strong>{{projectName}}</strong>
    </p>
  {{/if}}

  {{#if taskUrl}}
    <div style='margin-top:20px;'>
      <a
        href='{{taskUrl}}'
        style='background:#1a73e8; color:#fff; padding:10px 18px; border-radius:6px; text-decoration:none; font-size:14px;'
      >
        View Task
      </a>
    </div>
  {{/if}}

  <hr style='margin:20px 0; border:none; border-top:1px solid #eee;' />

  <p style='font-size:12px; color:#999; text-align:center;'>
    Stay on track by reviewing your tasks regularly.
  </p>

</div>