<div
  style='font-family: Arial, sans-serif; max-width:600px; margin:auto; background:#ffffff; border:1px solid #eee; border-radius:10px; padding:24px;'
>

  <h2 style='color:#1a73e8; margin-bottom:10px;'>
    You're Invited!
  </h2>

  <p style='color:#555; font-size:14px;'>
    You’ve been invited to collaborate on a project.
  </p>

  {{#if projectName}}
    <div
      style='margin-top:20px; padding:16px; border-radius:8px; background:#f5f9ff; border:1px solid #e3f2fd;'
    >
      <p style='margin:0; font-size:14px; color:#555;'>
        Project:
      </p>
      <h3 style='margin:5px 0 0 0; color:#333;'>
        {{projectName}}
      </h3>
    </div>
  {{/if}}

  {{#if inviterName}}
    <p style='margin-top:15px; font-size:14px; color:#555;'>
      Invited by:
      <strong>{{inviterName}}</strong>
    </p>
  {{/if}}

  <div style='margin-top:25px;'>
    <a
      href='{{inviteLink}}'
      style='background:#1a73e8; color:#fff; padding:12px 22px; border-radius:6px; text-decoration:none; font-size:14px; display:inline-block;'
    >
      Accept Invitation
    </a>
  </div>

  <p style='margin-top:15px; font-size:12px; color:#999; text-align:center;'>
    This invitation may expire soon. Please accept it promptly.
  </p>

  <hr style='margin:20px 0; border:none; border-top:1px solid #eee;' />

  <p style='font-size:12px; color:#aaa; text-align:center;'>
    If you weren’t expecting this invitation, you can safely ignore this email.
  </p>

</div>