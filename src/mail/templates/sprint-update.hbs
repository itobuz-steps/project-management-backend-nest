<div
  style='font-family: Arial, sans-serif; max-width:600px; margin:auto; background:#fff; border:1px solid #eee; border-radius:10px; padding:20px;'
>

  <h2 style='color:#1a73e8;'>
    {{sprintTitle}}
  </h2>

  <p style='color:#555; font-size:14px;'>
    A sprint has been updated in your project.
  </p>

  <div
    style='margin-top:20px; padding:16px; background:#f5f9ff; border:1px solid #e3f2fd; border-radius:8px;'
  >
    <h3 style='margin:0; color:#333;'>
      {{sprintKey}}
    </h3>

    {{#if projectName}}
      <p style='margin:5px 0; font-size:13px;'>
        Project:
        <strong>{{projectName}}</strong>
      </p>
    {{/if}}

    {{#if action}}
      <p style='margin-top:10px; font-size:14px; color:#1a73e8;'>
        {{action}}
      </p>
    {{/if}}
  </div>

  {{#if projectUrl}}
    <div style='margin-top:20px;'>
      <a
        href='{{projectUrl}}'
        style='background:#1a73e8; color:#fff; padding:10px 18px; border-radius:6px; text-decoration:none; font-size:14px;'
      >
        View Project
      </a>
    </div>
  {{/if}}

  <hr style='margin:20px 0; border:none; border-top:1px solid #eee;' />

  <p style='font-size:12px; color:#999; text-align:center;'>
    Stay aligned with your sprint goals.
  </p>

</div>