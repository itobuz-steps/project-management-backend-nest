<div
  style='font-family: Arial, sans-serif; max-width:600px; margin:auto; background:#ffffff; border:1px solid #eee; border-radius:10px; padding:20px;'
>

  <h2 style='color:#d32f2f; margin-bottom:10px;'>
    Task Deleted
  </h2>

  <p style='color:#555; font-size:14px;'>
    A task has been removed from your project.
  </p>

  <div
    style='margin-top:20px; padding:16px; border-radius:8px; background:#fdecea; border:1px solid #f5c6cb;'
  >

    <h3 style='margin:0 0 10px 0; color:#333;'>
      <span style='color:#333; font-weight:600;'>
        {{taskKey}}
      </span>
      —
      {{taskTitle}}
    </h3>

    <span
      style='
      display:inline-block;
      background:#f8d7da;
      color:#842029;
      padding:6px 12px;
      border-radius:20px;
      font-weight:bold;
      font-size:13px;
    '
    >
      Deleted
    </span>

    {{#if projectName}}
      <p style='margin:12px 0 0 0; font-size:14px; color:#555;'>
        Project:
        <strong>{{projectName}}</strong>
      </p>
    {{/if}}

  </div>

  {{#if actorName}}
    <p style='margin-top:15px; font-size:14px; color:#555;'>
      Deleted by:
      <strong>{{actorName}}</strong>
    </p>
  {{/if}}

  {{! <div
    style='margin-top:15px; padding:12px; background:#fff3cd; border-radius:6px; border:1px solid #ffeeba;'
  >
    <p style='margin:0; font-size:13px; color:#856404;'>
      If this action was unexpected, please contact your team or administrator.
    </p>
  </div> }}

  <hr style='margin:20px 0; border:none; border-top:1px solid #eee;' />

  <p style='font-size:12px; color:#999; text-align:center;'>
    This action may not be reversible. Stay organized and keep your team
    informed.
  </p>

</div>