<div
  style='font-family: Arial, sans-serif; max-width:600px; margin:auto; background:#ffffff; border:1px solid #eee; border-radius:10px; padding:20px;'
>

  <h2 style='color:#1a73e8; margin-bottom:10px;'>
    New Task Assigned
  </h2>

  <p style='color:#555; font-size:14px;'>
    You’ve been assigned a new task. Please review the details below:
  </p>

  <div
    style='margin-top:20px; padding:16px; border-radius:8px; background:#f5f9ff; border:1px solid #e3f2fd;'
  >

    <h3 style='margin:0 0 10px 0; color:#333;'>
      {{taskTitle}}
    </h3>

    <span
      style='
      display:inline-block;
      background:#e3f2fd;
      color:#0d47a1;
      padding:6px 12px;
      border-radius:20px;
      font-weight:bold;
      font-size:13px;
    '
    >
      Assigned to you
    </span>

    {{#if projectName}}
      <p style='margin:12px 0 0 0; font-size:14px; color:#555;'>
        Project:
        <strong>{{projectName}}</strong>
      </p>
    {{/if}}

  </div>

  {{#if actorName}}
    <p style='margin-top:15px; font-size:14px; color:#555;'>
      Assigned by:
      <strong>{{actorName}}</strong>
    </p>
  {{/if}}

  <div style='margin-top:20px;'>
    <a
      href='{{taskUrl}}'
      style='
      display:inline-block;
      padding:10px 16px;
      background:#1a73e8;
      color:#ffffff;
      text-decoration:none;
      border-radius:6px;
      font-size:14px;
    '
    >
      View Task
    </a>
  </div>

  <hr style='margin:20px 0; border:none; border-top:1px solid #eee;' />

  <p style='font-size:12px; color:#999; text-align:center;'>
    Stay productive and keep your tasks up to date.
  </p>

</div>