<div
  style='font-family: Arial, sans-serif; max-width:600px; margin:auto; background:#ffffff; border:1px solid #eee; border-radius:10px; padding:24px;'
>

  <h2 style='color:#1a73e8; margin-bottom:10px;'>
    Verify Your Email
  </h2>

  <p style='color:#555; font-size:14px;'>
    Hello,
  </p>

  <p style='color:#555; font-size:14px;'>
    Use the verification code below to continue:
  </p>

  <div
    style='
      margin:20px auto;
      width: fit-content;
      padding:14px 24px;
      font-size:28px;
      font-weight:bold;
      letter-spacing:4px;
      color:#1a73e8;
      background:#f5f9ff;
      border:1px solid #e3f2fd;
      border-radius:8px;
      text-align:center;
    '
  >
    {{otp}}
  </div>

  <p style='color:#555; font-size:14px;'>
    This code will expire shortly. Please do not share it with anyone.
  </p>

  <hr style='margin:20px 0; border:none; border-top:1px solid #eee;' />

  <p style='font-size:12px; color:#999; text-align:center;'>
    If you didn’t request this, you can safely ignore this email.
  </p>

</div>